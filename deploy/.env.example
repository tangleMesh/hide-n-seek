# Copy to deploy/.env and fill it in. (.env is never committed.)

# ---- server -------------------------------------------------------------------------------
# The release the live server runs. update.sh sets this automatically when a new GitHub release
# appears. Set it by hand to pin or roll back (e.g. HUSH_VERSION=v0.2.0).
HUSH_VERSION=latest
HUSH_IMAGE=ghcr.io/tanglemesh/hide-n-seek
# Local port the Cloudflare tunnel points at (http://localhost:8081). Bound to 127.0.0.1 only.
# castle-defense uses 8080 on the same host.
HOST_PORT=8081
# Same name as the dev setup, so a dump from there restores 1:1
MONGO_DB=hush
# Account names that may open /admin (bot training stats), comma-separated
ADMIN_USERS=jay
# Idle-time bot training: on | off
TRAINING=on
# Heap cap (MB) for the training worker. It restarts if it needs more; the game server never does.
TRAINING_MAX_MB=256
# Starting persona population
MIN_PERSONAS=24

# ---- automatic updates (update.sh) --------------------------------------------------------
# 1 = install new GitHub releases automatically; 0 = stay on HUSH_VERSION (pin / rollback)
AUTO_UPDATE=1
GITHUB_REPO=tangleMesh/hide-n-seek
# Only needed if the repository or its package is private (a token with read:packages / repo)
GITHUB_TOKEN=
# Wait at most this many minutes for running games to end before updating anyway
UPDATE_MAX_WAIT_MIN=30

# ---- backups to AWS S3 (the same bucket and IAM user as castle-defense works) --------------
S3_BUCKET=
S3_PREFIX=hush
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# Every N hours (168 = weekly)
BACKUP_INTERVAL_HOURS=168
# Keep the newest N backups in S3 (0 = keep all)
BACKUP_KEEP=12
